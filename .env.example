# ============================================================
# EdenSummary — пример переменных окружения.
# Скопируй в .env и заполни реальными значениями: cp .env.example .env
# .env в .gitignore — секреты в репозиторий не коммитим.
# ============================================================

# --- API ---
X_API_KEY=change-me-api-key

# --- ASR (Whisper) ---
# Groq:         WHISPER_API_BASE=https://api.groq.com/openai/v1
# local-server: WHISPER_API_BASE=http://whisper-server:8000/v1
WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_API_KEY=change-me-whisper-key
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=
MAX_CHARS=8000
CHUNK_OVERLAP_CHARS=1200
# Аудио длиннее этого (сек) режется на куски перед транскрипцией, чтобы каждый
# запрос укладывался с запасом под лимит ASR API. 16k mono WAV ≈ 32 KB/с, 300 с ≈
# 9.6 MB — заведомо ниже 25 MB Groq free (запросы у самого лимита, ~19 MB, рвёт
# connection reset). Self-hosted whisper-server без лимита → подними значение.
WHISPER_ASR_CHUNK_SECONDS=300
# Используется только сервисом whisper-server (профиль local-asr)
WHISPER_VAD_FILTER=true

# --- LLM (через litellm) ---
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=change-me-llm-key
LLM_API_BASE=
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
LLM_PARSE_MAX_ATTEMPTS=3
LLM_MAX_WORKERS=5
# Transcripts estimated at or below this many tokens are summarized in a single
# LLM call; longer ones fall back to map-reduce chunking.
LLM_SINGLE_PASS_TOKEN_LIMIT=32000
# Request native JSON output (response_format) from the model so it cannot return
# non-JSON. Disable only for providers that don't support OpenAI response_format.
LLM_JSON_MODE=true

# --- Tier-2 faithfulness judge (async, post-terminal) ---
# Grades the finished summary against the transcript in one LLM call. Uses a
# separate (non-summarizer) model on purpose. judge_api_* override the endpoint
# (e.g. OpenRouter) and fall back to LLM_API_* when blank. Skips evaluation when
# the transcript exceeds LLM_JUDGE_TOKEN_LIMIT estimated tokens.
LLM_JUDGE_ENABLED=true
LLM_JUDGE_MODEL=
LLM_JUDGE_API_BASE=
LLM_JUDGE_API_KEY=
LLM_JUDGE_TOKEN_LIMIT=32000

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me-app-password
SMTP_SENDER=

# --- Redis (Celery broker/backend) ---
REDIS_PASSWORD=change-me-redis-password

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=eden
DB_PASSWORD=change-me-db-password
DB_NAME=edensummary

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-s3-access
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=eden-artifacts
S3_REGION=us-east-1

# --- MinIO root (только для контейнера minio + createbuckets) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root

# --- Flower ---
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-flower-password